" commence " -> " start ";
" initiate " -> " start ";
" purchase " -> " buy ";
" utilised " -> " used ";
" utilized " -> " used ";
" utilise " -> " use ";
" utilize " -> " use ";
" whether " -> " if ";
" obtain " -> " get ";
" hence " -> " so ";

# --- Removed entirely (215) ---
# Includes function words, which are where the volume is. Output is
# no longer readable prose - this profile is for text headed to an
# embedding pipeline, not to a person. Negations are deliberately
# kept: dropping "not" inverts the meaning of the sentence.
